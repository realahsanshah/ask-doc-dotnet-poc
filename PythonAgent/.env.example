# Which real LLM provider to use when MOCK_LLM is not "true": "anthropic" or "openrouter"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Free-tier alternative: https://openrouter.ai/keys
# Set LLM_PROVIDER=openrouter above to use these instead of Anthropic.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Set to true to run without calling any LLM (returns a placeholder answer, retrieval still works)
MOCK_LLM=false
